# Copia este archivo como ".env" y completa tus datos.

# Correo que ENVÍA el reporte (Gmail por defecto)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: contraseña de aplicación (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=

# Correo(s) que RECIBEN el reporte, separados por coma
REPORT_EMAIL_TO=

# Hora local de Perú en la que se envía el resumen del día (HH:MM)
DAILY_REPORT_TIME=21:00
DAILY_REPORT_UTC_OFFSET=-5
DAILY_REPORT_ENABLED=1
